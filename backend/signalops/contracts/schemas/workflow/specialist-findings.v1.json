{
  "$defs": {
    "AgentEnding": {
      "enum": [
        "submitted",
        "no_turns",
        "turn_limit",
        "repair_limit",
        "refused",
        "budget_share",
        "skipped"
      ],
      "title": "AgentEnding",
      "type": "string"
    },
    "AgentRole": {
      "enum": [
        "investigator",
        "coordinator",
        "telemetry_investigator",
        "deployment_investigator",
        "dependency_investigator",
        "synthesizer",
        "verifier"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_signal_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Signal Ids",
          "type": "array"
        },
        "failure_type": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Type"
        },
        "references": {
          "default": [],
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*@[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "References",
          "type": "array"
        },
        "service_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Id"
        },
        "uncertainty": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "claim",
        "confidence",
        "uncertainty"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "How a role's output came about. Never the model's reasoning.",
      "properties": {
        "ended_by": {
          "$ref": "#/$defs/AgentEnding"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "model_turns": {
          "default": 0,
          "minimum": 0,
          "title": "Model Turns",
          "type": "integer"
        },
        "prompt_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Prompt Version",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "signals_read": {
          "default": 0,
          "minimum": 0,
          "title": "Signals Read",
          "type": "integer"
        },
        "tool_calls": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCallRef"
          },
          "maxItems": 64,
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role",
        "prompt_version",
        "ended_by"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SpecialistReport": {
      "additionalProperties": false,
      "description": "What a specialist submits.",
      "properties": {
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 5,
          "title": "Findings",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Limitations",
          "type": "array"
        },
        "missing_evidence": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Missing Evidence",
          "type": "array"
        }
      },
      "title": "SpecialistReport",
      "type": "object"
    },
    "ToolCallRef": {
      "additionalProperties": false,
      "properties": {
        "call_key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Call Key",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        }
      },
      "required": [
        "tool",
        "call_key"
      ],
      "title": "ToolCallRef",
      "type": "object"
    },
    "ToolName": {
      "enum": [
        "query_logs",
        "get_trace_summary",
        "get_deployments",
        "get_service_dependencies",
        "retrieve_runbooks"
      ],
      "title": "ToolName",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A specialist step's stored output.",
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "report": {
      "$ref": "#/$defs/SpecialistReport"
    },
    "role": {
      "$ref": "#/$defs/AgentRole"
    }
  },
  "required": [
    "role",
    "report",
    "provenance"
  ],
  "title": "SpecialistFindings",
  "type": "object"
}

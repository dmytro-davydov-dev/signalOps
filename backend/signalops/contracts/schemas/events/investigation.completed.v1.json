{
  "$defs": {
    "DiagnosisStatus": {
      "enum": [
        "diagnosed",
        "insufficient_evidence"
      ],
      "title": "DiagnosisStatus",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "signal.raw",
        "signal.normalized",
        "incident.changed",
        "investigation.requested",
        "investigation.completed",
        "processing.failed"
      ],
      "title": "EventType",
      "type": "string"
    },
    "InvestigationCompletedPayload": {
      "properties": {
        "diagnosis_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosisStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",
          "type": "string"
        },
        "investigation_id": {
          "format": "uuid",
          "title": "Investigation Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/InvestigationStatus"
        },
        "workflow_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Workflow Version",
          "type": "string"
        }
      },
      "required": [
        "investigation_id",
        "incident_id",
        "status",
        "workflow_version"
      ],
      "title": "InvestigationCompletedPayload",
      "type": "object"
    },
    "InvestigationStatus": {
      "enum": [
        "queued",
        "running",
        "completed",
        "insufficient_evidence",
        "failed",
        "cancelled",
        "budget_exceeded"
      ],
      "title": "InvestigationStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/InvestigationCompletedPayload"
    },
    "replay_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replay Run Id"
    },
    "schema_version": {
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "trace_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "workspace_id",
    "occurred_at",
    "ingested_at",
    "payload"
  ],
  "title": "EventEnvelope[InvestigationCompletedPayload]",
  "type": "object"
}

{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "latency_ms"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestFailureReason": {
        "enum": [
          "ambiguous_timeout",
          "broker_unavailable"
        ],
        "title": "IngestFailureReason",
        "type": "string"
      },
      "IngestRecordResult": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "index": {
            "minimum": 0.0,
            "title": "Index",
            "type": "integer"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngestRejectReason"
              },
              {
                "$ref": "#/components/schemas/IngestFailureReason"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "source_event_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Event Id"
          },
          "status": {
            "$ref": "#/components/schemas/IngestRecordStatus"
          }
        },
        "required": [
          "index",
          "status"
        ],
        "title": "IngestRecordResult",
        "type": "object"
      },
      "IngestRecordStatus": {
        "enum": [
          "accepted",
          "rejected",
          "failed"
        ],
        "title": "IngestRecordStatus",
        "type": "string"
      },
      "IngestRejectReason": {
        "enum": [
          "invalid_record",
          "oversized",
          "timestamp_out_of_range",
          "duplicate_in_batch",
          "missing_source_event_id"
        ],
        "title": "IngestRejectReason",
        "type": "string"
      },
      "IngestResponse": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "minimum": 0.0,
            "title": "Accepted",
            "type": "integer"
          },
          "batch_id": {
            "format": "uuid",
            "title": "Batch Id",
            "type": "string"
          },
          "failed": {
            "minimum": 0.0,
            "title": "Failed",
            "type": "integer"
          },
          "rejected": {
            "minimum": 0.0,
            "title": "Rejected",
            "type": "integer"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/IngestRecordResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "batch_id",
          "accepted",
          "rejected",
          "failed",
          "results"
        ],
        "title": "IngestResponse",
        "type": "object"
      },
      "JsonValue": {},
      "LivenessResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "NormalizedSignal": {
        "additionalProperties": false,
        "description": "A signal row as written by the normalizer.",
        "properties": {
          "attributes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Attributes",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ingested_at": {
            "format": "date-time",
            "title": "Ingested At",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SignalKind"
          },
          "message": {
            "maxLength": 8192,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "quality_flags": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/QualityFlag"
            },
            "maxItems": 8,
            "title": "Quality Flags",
            "type": "array"
          },
          "quality_status": {
            "$ref": "#/components/schemas/QualityStatus"
          },
          "replay_scope": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._:-]*$",
            "title": "Replay Scope",
            "type": "string"
          },
          "service_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Id"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "source_event_id": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Source Event Id",
            "type": "string"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "source_id",
          "service_id",
          "source_event_id",
          "replay_scope",
          "kind",
          "occurred_at",
          "ingested_at",
          "severity",
          "message",
          "quality_status"
        ],
        "title": "NormalizedSignal",
        "type": "object"
      },
      "QualityFlag": {
        "enum": [
          "malformed_payload",
          "missing_service",
          "unknown_service",
          "contradictory_identity",
          "clock_skew",
          "late_arrival",
          "truncated_message",
          "derived_event_id"
        ],
        "title": "QualityFlag",
        "type": "string"
      },
      "QualityStatus": {
        "enum": [
          "accepted",
          "degraded",
          "quarantined"
        ],
        "title": "QualityStatus",
        "type": "string"
      },
      "QualitySummary": {
        "additionalProperties": false,
        "description": "Per-source counts of signals ingested in the window (by `ingested_at`).",
        "properties": {
          "replay_scope": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._:-]*$",
            "title": "Replay Scope",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceQuality"
            },
            "maxItems": 1000,
            "title": "Sources",
            "type": "array"
          },
          "window": {
            "$ref": "#/components/schemas/TimeWindow"
          }
        },
        "required": [
          "replay_scope",
          "window",
          "sources"
        ],
        "title": "QualitySummary",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "Severity": {
        "enum": [
          "debug",
          "info",
          "warning",
          "error",
          "critical"
        ],
        "title": "Severity",
        "type": "string"
      },
      "SignalKind": {
        "enum": [
          "log",
          "trace",
          "deployment"
        ],
        "title": "SignalKind",
        "type": "string"
      },
      "SignalPage": {
        "additionalProperties": false,
        "description": "Signals by `occurred_at` descending, then ID descending.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NormalizedSignal"
            },
            "maxItems": 1000,
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "replay_scope": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._:-]*$",
            "title": "Replay Scope",
            "type": "string"
          },
          "window": {
            "$ref": "#/components/schemas/TimeWindow"
          }
        },
        "required": [
          "replay_scope",
          "window",
          "items"
        ],
        "title": "SignalPage",
        "type": "object"
      },
      "SourceKind": {
        "enum": [
          "structured_log",
          "trace_summary",
          "deployment"
        ],
        "title": "SourceKind",
        "type": "string"
      },
      "SourceQuality": {
        "additionalProperties": false,
        "properties": {
          "by_flag": {
            "additionalProperties": {
              "minimum": 0.0,
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/QualityFlag"
            },
            "title": "By Flag",
            "type": "object"
          },
          "by_status": {
            "additionalProperties": {
              "minimum": 0.0,
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/QualityStatus"
            },
            "title": "By Status",
            "type": "object"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "total": {
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "source_id",
          "name",
          "kind",
          "enabled",
          "total",
          "by_status",
          "by_flag"
        ],
        "title": "SourceQuality",
        "type": "object"
      },
      "TimeWindow": {
        "additionalProperties": false,
        "description": "Half-open interval: `since` inclusive, `until` exclusive.",
        "properties": {
          "since": {
            "format": "date-time",
            "title": "Since",
            "type": "string"
          },
          "until": {
            "format": "date-time",
            "title": "Until",
            "type": "string"
          }
        },
        "required": [
          "since",
          "until"
        ],
        "title": "TimeWindow",
        "type": "object"
      },
      "TraceEvidence": {
        "additionalProperties": false,
        "description": "Signals sharing a trace ID, by `occurred_at` ascending, then ID ascending.",
        "properties": {
          "replay_scope": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._:-]*$",
            "title": "Replay Scope",
            "type": "string"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/NormalizedSignal"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Signals",
            "type": "array"
          },
          "trace_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "title": "Trace Id",
            "type": "string"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "trace_id",
          "replay_scope",
          "signals",
          "truncated"
        ],
        "title": "TraceEvidence",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Source-specific ingestion token",
        "scheme": "bearer",
        "type": "http"
      },
      "OperatorBearer": {
        "description": "Operator token for one workspace",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "SignalOps API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "The process is running and serving requests.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Every required dependency answered within the readiness timeout.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/ingest/{source_id}": {
      "post": {
        "description": "Publish a batch of source records; each is accepted only after Kafka acknowledges it.",
        "operationId": "ingest_v1_ingest__source_id__post",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "Documents the request body. The route validates `records` item by item.",
                "properties": {
                  "records": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "occurred_at": {
                          "format": "date-time",
                          "title": "Occurred At",
                          "type": "string"
                        },
                        "payload": {
                          "additionalProperties": {},
                          "title": "Payload",
                          "type": "object"
                        },
                        "source_event_id": {
                          "anyOf": [
                            {
                              "maxLength": 512,
                              "minLength": 1,
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "title": "Source Event Id"
                        }
                      },
                      "required": [
                        "occurred_at",
                        "payload"
                      ],
                      "title": "IngestRecord",
                      "type": "object"
                    },
                    "minItems": 1,
                    "title": "Records",
                    "type": "array"
                  }
                },
                "required": [
                  "records"
                ],
                "title": "IngestRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            },
            "description": "At least one record failed; retry those with the same IDs"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Ingest",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/v1/signals": {
      "get": {
        "description": "Signals by `occurred_at` (newest first) in the window, with keyset pagination.\n\nA cursor carries its query's window; pass it with the same filters and\nleave `since`/`until` out (or equal). A cursor from another query is 400.",
        "operationId": "list_signals_v1_signals_get",
        "parameters": [
          {
            "description": "Replay dataset; `live` by default",
            "in": "query",
            "name": "replay_scope",
            "required": false,
            "schema": {
              "default": "live",
              "description": "Replay dataset; `live` by default",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "title": "Replay Scope",
              "type": "string"
            }
          },
          {
            "description": "Inclusive lower bound (RFC 3339)",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive lower bound (RFC 3339)",
              "title": "Since"
            }
          },
          {
            "description": "Exclusive upper bound (RFC 3339)",
            "in": "query",
            "name": "until",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive upper bound (RFC 3339)",
              "title": "Until"
            }
          },
          {
            "in": "query",
            "name": "source_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source Id"
            }
          },
          {
            "in": "query",
            "name": "service_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Service Id"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SignalKind"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "quality_status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/QualityStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Quality Status"
            }
          },
          {
            "description": "At most SIGNALOPS_QUERY_MAX_LIMIT",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "At most SIGNALOPS_QUERY_MAX_LIMIT",
              "title": "Limit"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid or mismatched cursor"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OperatorBearer": []
          }
        ],
        "summary": "List Signals",
        "tags": [
          "evidence"
        ]
      }
    },
    "/v1/sources/quality": {
      "get": {
        "description": "Per-source signal counts by quality status and flag, for signals ingested in the window.",
        "operationId": "source_quality_v1_sources_quality_get",
        "parameters": [
          {
            "description": "Replay dataset; `live` by default",
            "in": "query",
            "name": "replay_scope",
            "required": false,
            "schema": {
              "default": "live",
              "description": "Replay dataset; `live` by default",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",

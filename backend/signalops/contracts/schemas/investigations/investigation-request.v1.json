{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of POST /v1/incidents/{id}/investigations; limits only lower the configured ones.",
  "properties": {
    "budget_microusd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Microusd"
    },
    "deadline_seconds": {
      "anyOf": [
        {
          "minimum": 60,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline Seconds"
    },
    "max_steps": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Steps"
    }
  },
  "title": "InvestigationRequest",
  "type": "object"
}

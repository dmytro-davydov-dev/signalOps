{
  "$defs": {
    "AgentRole": {
      "enum": [
        "investigator",
        "coordinator",
        "telemetry_investigator",
        "deployment_investigator",
        "dependency_investigator",
        "synthesizer",
        "verifier"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "DiagnosisStatus": {
      "enum": [
        "diagnosed",
        "insufficient_evidence"
      ],
      "title": "DiagnosisStatus",
      "type": "string"
    },
    "InvestigationEnded": {
      "additionalProperties": false,
      "properties": {
        "diagnosis_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosisStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/InvestigationStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "InvestigationEnded",
      "type": "object"
    },
    "InvestigationStatus": {
      "enum": [
        "queued",
        "running",
        "completed",
        "insufficient_evidence",
        "failed",
        "cancelled",
        "budget_exceeded"
      ],
      "title": "InvestigationStatus",
      "type": "string"
    },
    "ProgressEventType": {
      "enum": [
        "step.started",
        "step.completed",
        "step.failed",
        "investigation.ended"
      ],
      "title": "ProgressEventType",
      "type": "string"
    },
    "ProgressEventView": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/ProgressEventType"
        },
        "id": {
          "exclusiveMinimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepFailed"
            },
            {
              "$ref": "#/$defs/StepProgress"
            },
            {
              "$ref": "#/$defs/InvestigationEnded"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "id",
        "event_type",
        "payload",
        "created_at"
      ],
      "title": "ProgressEventView",
      "type": "object"
    },
    "StepFailed": {
      "additionalProperties": false,
      "properties": {
        "agent_role": {
          "$ref": "#/$defs/AgentRole"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "error_category": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Error Category",
          "type": "string"
        },
        "step_key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Step Key",
          "type": "string"
        }
      },
      "required": [
        "step_key",
        "agent_role",
        "attempt",
        "error_category"
      ],
      "title": "StepFailed",
      "type": "object"
    },
    "StepProgress": {
      "additionalProperties": false,
      "properties": {
        "agent_role": {
          "$ref": "#/$defs/AgentRole"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "step_key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Step Key",
          "type": "string"
        }
      },
      "required": [
        "step_key",
        "agent_role",
        "attempt"
      ],
      "title": "StepProgress",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of GET /v1/investigations/{id}/progress, oldest event first.",
  "properties": {
    "investigation_id": {
      "format": "uuid",
      "title": "Investigation Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ProgressEventView"
      },
      "maxItems": 1000,
      "title": "Items",
      "type": "array"
    },
    "next_after": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next After"
    },
    "replay_scope": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "title": "Replay Scope",
      "type": "string"
    }
  },
  "required": [
    "investigation_id",
    "replay_scope",
    "items"
  ],
  "title": "ProgressPage",
  "type": "object"
}

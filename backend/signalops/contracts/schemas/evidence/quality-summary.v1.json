{
  "$defs": {
    "QualityFlag": {
      "enum": [
        "malformed_payload",
        "missing_service",
        "unknown_service",
        "contradictory_identity",
        "clock_skew",
        "late_arrival",
        "truncated_message",
        "derived_event_id"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "QualityStatus": {
      "enum": [
        "accepted",
        "degraded",
        "quarantined"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "structured_log",
        "trace_summary",
        "deployment"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceQuality": {
      "additionalProperties": false,
      "properties": {
        "by_flag": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "By Flag",
          "type": "object"
        },
        "by_status": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/QualityStatus"
          },
          "title": "By Status",
          "type": "object"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "name",
        "kind",
        "enabled",
        "total",
        "by_status",
        "by_flag"
      ],
      "title": "SourceQuality",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Half-open interval: `since` inclusive, `until` exclusive.",
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Per-source counts of signals ingested in the window (by `ingested_at`).",
  "properties": {
    "replay_scope": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "title": "Replay Scope",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceQuality"
      },
      "maxItems": 1000,
      "title": "Sources",
      "type": "array"
    },
    "window": {
      "$ref": "#/$defs/TimeWindow"
    }
  },
  "required": [
    "replay_scope",
    "window",
    "sources"
  ],
  "title": "QualitySummary",
  "type": "object"
}

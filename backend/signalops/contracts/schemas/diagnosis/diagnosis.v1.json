{
  "$defs": {
    "AgentRole": {
      "enum": [
        "investigator",
        "coordinator",
        "telemetry_investigator",
        "deployment_investigator",
        "dependency_investigator",
        "synthesizer",
        "verifier"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Assessment",
          "type": "string"
        },
        "hypothesis": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        }
      },
      "required": [
        "hypothesis",
        "assessment"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Contradiction": {
      "additionalProperties": false,
      "description": "Findings that point different ways, kept visible rather than merged away.",
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_signal_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Signal Ids",
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentRole"
          },
          "maxItems": 3,
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "description"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "DiagnosisStatus": {
      "enum": [
        "diagnosed",
        "insufficient_evidence"
      ],
      "title": "DiagnosisStatus",
      "type": "string"
    },
    "RootCause": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_signal_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Evidence Signal Ids",
          "type": "array"
        },
        "failure_type": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Failure Type",
          "type": "string"
        },
        "service_id": {
          "format": "uuid",
          "title": "Service Id",
          "type": "string"
        },
        "service_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Service Name",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "service_name",
        "failure_type",
        "confidence",
        "evidence_signal_ids"
      ],
      "title": "RootCause",
      "type": "object"
    },
    "SuggestedAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "requires_approval": {
          "const": true,
          "default": true,
          "title": "Requires Approval",
          "type": "boolean"
        }
      },
      "required": [
        "action"
      ],
      "title": "SuggestedAction",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "maxItems": 10,
      "title": "Alternatives",
      "type": "array"
    },
    "contradictions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "maxItems": 10,
      "title": "Contradictions",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Limitations",
      "type": "array"
    },
    "missing_evidence": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Missing Evidence",
      "type": "array"
    },
    "root_cause": {
      "anyOf": [
        {
          "$ref": "#/$defs/RootCause"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/DiagnosisStatus"
    },
    "suggested_actions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SuggestedAction"
      },
      "maxItems": 10,
      "title": "Suggested Actions",
      "type": "array"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "workflow_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "title": "Workflow Version",
      "type": "string"
    }
  },
  "required": [
    "status",
    "summary",
    "root_cause",
    "workflow_version"
  ],
  "title": "Diagnosis",
  "type": "object"
}

    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^16",
    "jsdom": "^26",

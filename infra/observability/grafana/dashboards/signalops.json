        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "signalops-prometheus"
          },
          "expr": "sum by (consumer_group) (signalops_kafka_consumer_lag)",
          "legendFormat": "{{consumer_group}}",
          "refId": "A"

# Copy to .env for local development: cp .env.example .env
# Placeholders only. Never commit a real .env.

# PostgreSQL (local container credentials)
POSTGRES_DB=signalops
POSTGRES_USER=signalops
POSTGRES_PASSWORD=change-me-local-only
# Login roles `migrate` creates for the application (docs/evaluation.md).
# The runtime role (API, consumers, workers) cannot read evaluation ground
# truth; only the evaluator role can. Unset, each falls back to
# POSTGRES_PASSWORD, which is acceptable only on a local machine.
SIGNALOPS_DB_RUNTIME_PASSWORD=change-me-runtime-local-only
SIGNALOPS_DB_EVALUATOR_PASSWORD=change-me-evaluator-local-only

# Host ports, bound to 127.0.0.1 only. Change if they clash locally.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
KAFKA_HOST_PORT=19094

# Application host ports
API_HOST_PORT=8010
WEB_HOST_PORT=8090

# Observability profile (docker compose --profile observability up -d)
PROMETHEUS_HOST_PORT=59090
GRAFANA_HOST_PORT=53000
# Grafana admin account; anonymous viewers can already read the dashboard.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-local-only

# Backend processes (Compose passes these through as SIGNALOPS_* variables)
SIGNALOPS_LOG_LEVEL=INFO

# Model provider: `fake` is deterministic, needs no key, and is the default.
# `anthropic` makes paid calls, each one bounded by an investigation's budget.
# SIGNALOPS_MODEL_PROVIDER=fake
# SIGNALOPS_MODEL_NAME=
# SIGNALOPS_MODEL_API_KEY=<anthropic-api-key>
# Fake provider only: seconds before each reply. The browser journey check
# (apps/web/e2e) uses 3 so it can watch, reconnect to, and cancel a running run.
# SIGNALOPS_FAKE_MODEL_DELAY_SECONDS=0

# Ingestion tokens: JSON object of source ID to bearer token, single-quoted.
# The IDs are the seeded demo sources (structured logs, trace summaries,
# deployments). Replace each placeholder with a long random value, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Unset or {} means no source can ingest.
SIGNALOPS_INGEST_TOKENS='{"b6c72d79-7ec9-4df7-88d0-1d4332c88808":"<logs-token>","1dee9492-8198-4ab9-af5e-9bcc709660fd":"<traces-token>","ad03a959-871e-4eeb-bb3f-dc63a69372aa":"<deployments-token>"}'

# Operator tokens for the evidence query APIs: JSON object of workspace ID to
# bearer token, single-quoted. The ID is the seeded demo workspace. Each token
# must differ from every ingestion token. Unset or {} means every operator
# request is rejected.
SIGNALOPS_OPERATOR_TOKENS='{"82631aa1-86f5-4d37-b39f-fac74ebbdac8":"<operator-token>"}'

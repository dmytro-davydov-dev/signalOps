# Copy to .env for local development: cp .env.example .env
# Placeholders only. Never commit a real .env.

# PostgreSQL (local container credentials)
POSTGRES_DB=signalops
POSTGRES_USER=signalops
POSTGRES_PASSWORD=change-me-local-only

# Host ports, bound to 127.0.0.1 only. Change if they clash locally.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
KAFKA_HOST_PORT=19094

# Application host ports
API_HOST_PORT=8010
WEB_HOST_PORT=8090

# Backend processes (Compose passes these through as SIGNALOPS_* variables)
SIGNALOPS_LOG_LEVEL=INFO

# Model provider: only the deterministic fake provider exists, so no model
# API key is needed or read. Real providers arrive in P07-T01 with explicit,
# budgeted configuration.

# Ingestion tokens: JSON object of source ID to bearer token, single-quoted.
# The IDs are the seeded demo sources (structured logs, trace summaries,
# deployments). Replace each placeholder with a long random value, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Unset or {} means no source can ingest.
SIGNALOPS_INGEST_TOKENS='{"b6c72d79-7ec9-4df7-88d0-1d4332c88808":"<logs-token>","1dee9492-8198-4ab9-af5e-9bcc709660fd":"<traces-token>","ad03a959-871e-4eeb-bb3f-dc63a69372aa":"<deployments-token>"}'
